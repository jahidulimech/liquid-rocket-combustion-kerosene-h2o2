FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ============================================================
//  2-D AXISYMMETRIC WEDGE MESH  (theta = 5 deg total, 1 cell thick)
//  Purdue CVRC single-element coaxial rocket engine
//  Liu et al. (2023) Phys. Fluids 35, 125141
//
//  COORDINATE SYSTEM:
//    Origin at dump plane. x<0 = oxidizer post. x>0 = chamber+nozzle.
//
//  GEOMETRY:
//    Oxidizer post       x: -0.170 to  0.000   r = Ro = 0.01025 m
//    Combustion chamber  x:  0.000 to  0.381   r = Rc = 0.02250 m
//    Converging nozzle   x:  0.381 to  0.401   r: Rc->Rt (curved arc)
//    Throat (outlet)     x:  0.401              r = Rt = 0.01050 m
//
//  WEDGE: theta=5 deg, alpha=2.5 deg
//    sin(2.5deg) = 0.043619387365336
//    cos(2.5deg) = 0.999048221581858
//
//    All y/z computed as y=r*cos(alpha), z=+-r*sin(alpha)
//    so z/y = tan(2.5deg) is identical for every vertex -> planar wedge faces.
//
//    Ro=0.01025 -> y=0.010240244271  z=+/-0.000447098720
//    Rc=0.02250 -> y=0.022478584986  z=+/-0.000981436216
//    Rt=0.01050 -> y=0.010490006327  z=+/-0.000458003567
//    Arc r=0.01350 -> y=0.013487150991  z=+/-0.000588861729
//
//  BLOCK TOPOLOGY (5 blocks):
//    B0: ox. post       axis->Ro  x=-0.170->0.000
//    B1: ch. inner      axis->Ro  x= 0.000->0.381
//    B2: ch. outer      Ro->Rc    x= 0.000->0.381
//    B3: nozzle inner   axis->Ro  x= 0.381->0.401
//    B4: nozzle outer   Ro->wall  x= 0.381->0.401  (curved wall)
//
//  CELL COUNT (~27,250 total):
//    B0: 100x25=  2,500
//    B1: 400x25= 10,000
//    B2: 400x30= 12,000
//    B3:  50x25=  1,250
//    B4:  50x30=  1,500
//    TOTAL:      27,250
// ============================================================

scale 1;

vertices
(
    // x = -0.170 | Oxidizer Post Inlet
    (-0.170   0.000000000000   0.000000000000)   //  0  axis
    (-0.170   0.010240244271  -0.000447098720)   //  1  Ro back
    (-0.170   0.010240244271   0.000447098720)   //  2  Ro front

    // x = 0.000 | Dump Plane
    ( 0.000   0.000000000000   0.000000000000)   //  3  axis
    ( 0.000   0.010240244271  -0.000447098720)   //  4  Ro back
    ( 0.000   0.010240244271   0.000447098720)   //  5  Ro front
    ( 0.000   0.022478584986  -0.000981436216)   //  6  Rc back
    ( 0.000   0.022478584986   0.000981436216)   //  7  Rc front

    // x = 0.381 | Chamber Exit / Nozzle Entry
    ( 0.381   0.000000000000   0.000000000000)   //  8  axis
    ( 0.381   0.010240244271  -0.000447098720)   //  9  Ro back
    ( 0.381   0.010240244271   0.000447098720)   // 10  Ro front
    ( 0.381   0.022478584986  -0.000981436216)   // 11  Rc back
    ( 0.381   0.022478584986   0.000981436216)   // 12  Rc front

    // x = 0.401 | Nozzle Throat (outlet)
    ( 0.401   0.000000000000   0.000000000000)   // 13  axis
    ( 0.401   0.010240244271  -0.000447098720)   // 14  Ro back  (B3/B4 interface)
    ( 0.401   0.010240244271   0.000447098720)   // 15  Ro front
    ( 0.401   0.010490006327  -0.000458003567)   // 16  Rt back  (throat wall)
    ( 0.401   0.010490006327   0.000458003567)   // 17  Rt front
);

blocks
(
    // B0: Oxidizer Post (axis->Ro, x=-0.170->0.000)
    hex ( 0  3  4  1    0  3  5  2)
    (100 25 1)
    simpleGrading (1 4 1)

    // B1: Chamber Inner Core (axis->Ro, x=0.000->0.381)
    hex ( 3  8  9  4    3  8 10  5)
    (400 25 1)
    simpleGrading (1 4 1)

    // B2: Chamber Outer Annulus (Ro->Rc, x=0.000->0.381)
    hex ( 4  9 11  6    5 10 12  7)
    (400 30 1)
    simpleGrading (1 0.25 1)

    // B3: Nozzle Inner Core (axis->Ro, x=0.381->0.401)
    hex ( 8 13 14  9    8 13 15 10)
    (50 25 1)
    simpleGrading (0.3 4 1)

    // B4: Nozzle Outer Annulus, curved wall (Ro->wall, x=0.381->0.401)
    hex ( 9 14 16 11   10 15 17 12)
    (50 30 1)
    simpleGrading (0.3 0.25 1)
);

edges
(
    // Nozzle curved wall arcs (outer edge of B4)
    // Arc midpoint at x=0.391, r=0.01350:
    //   y = 0.01350 * cos(2.5deg) = 0.013487150991
    //   z = 0.01350 * sin(2.5deg) = 0.000588861729
    arc 11 16 ( 0.391   0.013487150991  -0.000588861729)   // back face
    arc 12 17 ( 0.391   0.013487150991   0.000588861729)   // front face
);

boundary
(
    // Oxidizer inlet: x=-0.170, r=0->Ro
    oxidizerInlet
    {
        type patch;
        faces
        (
            (0 2 1 0)   // B0 i-min (degenerate triangle at axis)
        );
    }

    // Fuel inlet: x=0.000 annular face, r=Ro->Rc
    fuelInlet
    {
        type patch;
        faces
        (
            (4 5 7 6)   // B2 i-min
        );
    }

    // Outlet: x=0.401 full throat, r=0->Rt
    outlet
    {
        type patch;
        faces
        (
            (13 15 14 13)   // B3 i-max: axis->Ro (degenerate triangle)
            (14 15 17 16)   // B4 i-max: Ro->Rt
        );
    }

    // Walls: no-slip adiabatic
    walls
    {
        type wall;
        faces
        (
            (1 4 5 2)       // Post outer wall (r=Ro, x=-0.170->0.000)
            (6 7 12 11)     // Chamber outer wall (r=Rc, x=0.000->0.381)
            (11 12 17 16)   // Nozzle wall: curved arc Rc->Rt
        );
    }

    // Wedge back: z<0 plane at -2.5 deg
    wedge_back
    {
        type wedge;
        faces
        (
            ( 0  1  4  3)   // B0
            ( 3  4  9  8)   // B1
            ( 4  6 11  9)   // B2
            ( 8  9 14 13)   // B3
            ( 9 11 16 14)   // B4
        );
    }

    // Wedge front: z>0 plane at +2.5 deg
    wedge_front
    {
        type wedge;
        faces
        (
            ( 0  3  5  2)   // B0
            ( 3  8 10  5)   // B1
            ( 5 10 12  7)   // B2
            ( 8 13 15 10)   // B3
            (10 12 17 15)   // B4
        );
    }
);

mergePatchPairs ();

