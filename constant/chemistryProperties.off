FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}

chemistryType
{
    solver          EulerImplicit;
    method          standard;
}

chemistry           off;
chemistryReader     foamChemistryReader;
foamChemistryFile   "<constant>/reactions";
initialChemicalTimeStep 1e-10;
maxT    4300;

EulerImplicitCoeffs
{
    cTauChem                0.001;
    equilibriumRateLimiter  on;
}

// ************************************************************************* //