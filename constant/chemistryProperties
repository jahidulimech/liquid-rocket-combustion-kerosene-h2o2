FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}

chemistryType
{
    solver          ode;
}

chemistry           on;
chemistryReader     foamChemistryReader;
foamChemistryFile   "<constant>/reactions";
initialChemicalTimeStep 1e-07;
maxT    4300;

odeCoeffs
{
    solver          seulex;
    eps             0.05;
}

