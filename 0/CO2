FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      CO2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Liu et al. (2023) Phys. Fluids 35, 125141
// CO2 mass fraction - combustion product
// C12H26 + 18.5 O2 -> 12 CO2 + 13 H2O
// At O/F=6.3 (lean): Y_CO2 in products ~ 0.25

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    oxidizerInlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    fuelInlet
    {
    	type    fixedValue;
    	value   uniform 0.0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.0;
        value           uniform 0.50;
    }

    walls
    {
        type            zeroGradient;
    }

    wedge_back
    {
        type            wedge;
    }

    wedge_front
    {
        type            wedge;
    }
}
