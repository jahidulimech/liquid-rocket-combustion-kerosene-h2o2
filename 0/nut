FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Liu et al. (2023) Phys. Fluids 35, 125141
// RANS turbulent viscosity (nut)
// nut = Cmu * k^2 / epsilon  (computed by solver)
// Initial estimate: nut ~ 10 * nu_molecular at 900K, 1.2MPa

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    oxidizerInlet
    {
        // RANS: nut at velocity inlets is calculated by the solver
        type            calculated;
        value           uniform 1e-4;
    }

    fuelInlet
    {
        type            calculated;
        value           uniform 1e-4;
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        // LES: no wall function, zero SGS viscosity at wall
        type            fixedValue;
        value           uniform 0.0;
    }

    wedge_back
    {
        type            wedge;
    }

    wedge_front
    {
        type            wedge;
    }
}
